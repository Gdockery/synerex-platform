# All URLs use relative paths so the website works from any host (local, Tailscale, VPN, domain).
# Nginx proxies /license, /tracking, /emv, /service-manager to the platform backend.
VITE_LICENSE_SERVICE_URL=/license
VITE_EMV_URL=/emv
VITE_TRACKING_PROGRAM_URL=/tracking
VITE_WEBSITE_BACKEND_URL=
VITE_WEBSITE_FRONTEND_URL=
VITE_SERVICE_MANAGER_URL=/service-manager
