<%
/*

You can replace anything in this view.  It just needs to POST a request to /login with
"email" and "password" parameters.  If the request is successful, navigate to / .  If
there is a 404, display a "user/password" not found message.  If other error, display
a generic error message.  Also can put a link on this page to /forgot-password.

 */
%>
<script src="/scripts/jquery-3.7.1.min.js"></script>
<script type="text/javascript">
$(function() {

  var isWaiting;
  $('form[data-purpose="login"]').on('submit', function() {
    if (isWaiting) { return; }
    isWaiting = true;

    $('.error').hide();
    $.post('/login', { email: $('#inputEmail').val(), password: $('#inputPassword').val() })
    .done(function() {
      window.location = '/welcome#loaded';
    })
    .fail(function(err) {
      isWaiting = false;

      if (err.status === 404) {
        $('.error').show().html('Unrecognized email address/password combination.');
      }
      else if (err.status === 400) {
        $('.error').show().html('Please make sure you\'ve entered a valid email address and password.');
      }
      else {
        $('.error').show().html('Unknown error occurred, please try again.');
      }
    });

    return false;
	});//</on click>
	
	if(location.href.match('expired')) {
		$('.error').show().html('Session Expired. Login Again.');
	}
});
</script>
<link rel="stylesheet" type="text/css" href="/css/font-awesome.css">
<link rel="stylesheet" type="text/css" href="/css/public-screens.css">
<link rel="stylesheet" type="text/css" href="/css/login.css">
<div class="login-container">
  
  <div class="logo-container">
    <div class="row1">
      <img id="profile-img" class="logo-image" src="/images/logo-big1.png" />
    </div>
    <div class="row2">
      EMV Energy & Cost Analysis Portal
    </div>
  </div>
  
  <form class="form-container" data-purpose="login">
    <span id="reauth-email" class="reauth-email"></span>
    <input type="email" id="inputEmail" class="form-control" placeholder="Email Address" required autofocus>
    <input type="password" id="inputPassword" class="form-control" placeholder="Password" required>
    <span class="error">what?</span>
    <br>
      <div>
        <input type="checkbox" id="termsAndConditions" class="form-control" name="terms" value="accept" required oninvalid="this.setCustomValidity('Please read and accept our terms & conditions to use the portal')" onchange="this.setCustomValidity('')">
        <label for="termsAndConditions"><a href="/terms"><strong>I Accept Terms & Conditions</strong></a></label>
      </div>
    <button class="btn btn-signin btn-green btn-submit" >Sign in</button>
    <br>
    <a href="/forgot-password" class="bottom-link"><strong>Forgot password?</strong></a>
  </form>
</div>

<!-- FOOTER -->
<%- partial('partials/footer.ejs') %>
