<% 
/*
 * Invite user email 
 * 
 * This email is sent to a new user when they are created without a password.
 *
 * Available data:
 * + user (the user that the email is being sent to, see api/models/User.js for attributes)
 * + link (the URL of the "accept invite" page)
 *
 */
%>


<% var brandName = typeof brandName !== 'undefined' ? brandName : 'Xeco'; %>
<p>Hi <%= user.firstName %>,</p>

<p>You&rsquo;ve been invited to join the <%= brandName %> Energy Portal!</p>

<p>Click the link below to set up your account and choose your password:</p>

<p><a href="<%= link %>"><%= link %></a></p>

<p>
  If you have any questions, please contact your <%= brandName %> Energy representative.<br/>
  <br/>
  Welcome aboard!<br/>
  The <%= brandName %> Team
</p>
