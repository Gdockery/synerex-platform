<% 
/*
 * Reset password email 
 * 
 * This email is sent to a user when requesting a password reset.
 *
 * Available data:
 * + user (the user that the email is being sent to, see api/models/User.js for attributes)
 * + link (the URL of the "reset password" page)
 *
 */
%>


<p>Hi <%= user.firstName %>,</p>

<p>Here&rsquo;s that new password link: <%= link %></p>

<% var brandName = typeof brandName !== 'undefined' ? brandName : 'Xeco'; %>
<p>
  You&rsquo;re welcome,<br/>
  The <%= brandName %> Team
</p>
