<script src="/scripts/jquery-3.7.1.min.js"></script>
<script type="text/javascript">

$(function() {
  $('button[type="submit"]').on('click', function() {
    $('.error').hide();

    // Validate passwords match
    if ($('#password').val() !== $('#confirm_password').val()) {
      $('.error').show().html('Your passwords do not match');
      return;
    }

    // Validate agreement checkbox
    if (!$('#userAgreement').is(':checked')) {
      $('.error').show().html('Please accept End User Agreement to use the portal');
      return;
    }

    // Get token from URL instead of hardcoding
    const urlParams = new URLSearchParams(window.location.search);
    const token = urlParams.get('token');
    if (!token) {
      $('.error').show().html('Invalid or missing token.');
      return;
    }

    // Send password request with Authorization Header
    $.ajax({
      url: '/api/account',
      method: 'POST',
      contentType: 'application/json',
      headers: { "Authorization": "Bearer " + token },
  data: JSON.stringify({
    token: token,  // Send token in request body
    password: $('#password').val()
  })
    })
    .done(function() {
      // Store token for future use
      localStorage.setItem('authToken', token);

      // Redirect to homepage or dashboard
      window.location = '/';
    })
    .fail(function(err) {
      $('.error').show().html('Error occurred: ' + (err.responseJSON?.message || 'Please try again.'));
    });

    return false;
  });
});


