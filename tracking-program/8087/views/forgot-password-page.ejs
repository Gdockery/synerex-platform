<%
/*

 You can replace anything in this view.  It just needs to POST a request to /reset-password-email with
 an "email" parameter.  If the request is successful, show a "you'll get an email if you deserver one"
 message.  If there's any error, display a generic "an error occurrred" message.  Maybe also a link
 back to the home page.

 */
%>

<style>
  .form-signin .btn-reset {
    border-radius:5px;
    -moz-border-radius:5px;
    -webkit-border-radius:5px;
    max-width: 50%;
    padding: 12px;
    margin: 50px auto 20px auto;
  }
</style>
<link rel="stylesheet" type="text/css" href="/css/font-awesome.css">
<link rel="stylesheet" type="text/css" href="/css/public-screens.css">
<link rel="stylesheet" type="text/css" href="/css/login.css">

<script src="/scripts/jquery-2.2.4.min.js"></script>
<script type="text/javascript">
  $(function() {
    $('.btn-reset').on('click', function() {
      $('.error').hide();
      $('.msg').hide();
      $.post('/reset-password-email', { email: $('#inputEmail').val() })
        .done(function() {
          $('.msg').show().html('If the email address matches one on file, you will receive a message containing password reset instructions.');
        })
        .fail(function(err) {
          $('.error').show().html('Unknown error occurred, please try again.');
        })
      return false;
    })
  });
</script>
<div class="container">
  <div class="card card-container">
    <img id="profile-img" class="logo-image" src="/images/logo-big.png" />
    <h1>Reset Password</h1>
    <form class="form-signin">
      <span id="reauth-email" class="reauth-email"></span>
      <input type="email" id="inputEmail" class="form-control" placeholder="Email address" required autofocus>
      <span class="msg"></span>
      <span class="error"></span>
      <button class="btn btn-green btn-reset">Submit</button>
    </form>
    <a href="/login" class="bottom-link">
      Back to login
    </a>
  </div>
</div>

<!-- FOOTER -->
<%- partial('partials/footer.ejs') %>
