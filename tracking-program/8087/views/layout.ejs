<!DOCTYPE html>
<html>
  <head>
    <title><% var brandName = sails.config.whitelabel.getBrandName(req.hostname || req.get('host') || ''); %><%= brandName %> Energy</title>
    <link rel="shortcut icon" href="/images/favicon.ico?v=<%= new Date().getTime() %>" type="image/x-icon">
    <link href="/css/open-sans.css" rel="stylesheet">

    <!-- Viewport mobile tag for sensible mobile support -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
  </head>

  <body>
    <div class="page-wrap">
    <%- body %>
    </div>
  </body>
</html>

<style>
html, body {
  height: 100%;
}
.page-wrap {
  min-height: 100%;
  /* equal to footer height */
  margin-bottom: -50px; 
	overflow: hidden;
}
.page-wrap:after {
  content: "";
  display: block;
}
.page-wrap:after {
  height: 50px; 
}
</style>
