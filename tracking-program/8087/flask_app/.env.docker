# Tracking Flask - Docker defaults
# Override TRACKING_DB_URL, LICENSE_SERVICE_URL via docker-compose environment
TRACKING_DB_URL=mysql://tracking_user:TrackingPass123@mysql-tracking:3306/tracking
LICENSE_SERVICE_URL=http://license-service:8000
# Browser-accessible URL for purchase/redirect links
LICENSE_SERVICE_PUBLIC_URL=http://localhost:8080/license
EMV_URL=http://emv-program:8082
MY_ACCOUNT_URL=http://website:80
WEBSITE_URL=http://website:80
TRACKING_BASE_URL=http://proxy:80/tracking
EMV_API_KEY=tracking-push-secret
# Leave blank so Flask uses the request host dynamically (works for any remote IP/VPN)
TRACKING_PUBLIC_WEBSITE_URL=
ADMIN_RESTART_SECRET=synerex-admin-restart-secret
PORT=8087
FLASK_ENV=production
SECRET_KEY=change-me-in-production
STORAGE_LOCAL_PATH=/app/8087/assets
WHITELABEL_BASE_PATH=/app/8087/whitelabel
PDF_BRIDGE_PATH=/app/8087/scripts/pdf-bridge.js
