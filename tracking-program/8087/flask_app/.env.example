# =============================================================================
# Tracking Program - Flask Migration - Environment Variables
# =============================================================================
# Copy this file to .env and fill in values. Never commit .env to version control.
# Source: tracking-program/8087/config/*.js
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# MySQL connection URL (sails-mysql2 compatible, MySQL 8)
# Format: mysql://user:password@host:port/database (PyMySQL used; converted to mysql+pymysql://)
# If empty, app uses sqlite :memory: so it can start (DB routes will fail)
TRACKING_DB_URL=mysql://user:password@localhost:3306/tracking
# Per-org database (consistent with EMV): each org gets own SQLite file when using SQLite
# Set to true to enable; requires no TRACKING_DB_URL (SQLite mode)
# TRACKING_USE_PER_ORG_DB=false
# Path for per-org SQLite DBs (default: flask_app/tracking_data)
# TRACKING_RESULTS_DIR=tracking_data

# -----------------------------------------------------------------------------
# EMV Integration (Bill Analytic import, Push Analysis)
# -----------------------------------------------------------------------------
# Shared API key for service-to-service calls from EMV. Set same value in EMV .env.
# Required for /api/emv/projects, /api/emv/project/bill-analytic, /api/emv/push-baseline
EMV_API_KEY=tracking-push-secret

# -----------------------------------------------------------------------------
# License Service
# -----------------------------------------------------------------------------
# Synerex License Service - used for JWT verification and license checks
# GET /api/licenses/check?org_id=&program_id=tracking
# POST /auth/api/verify-jwt (JWT validation)
LICENSE_SERVICE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Synerex Platform URLs (for links in UI)
# -----------------------------------------------------------------------------
# EMV Program - My Account page link
EMV_URL=http://localhost:8082
# My Account page (shared across programs)
MY_ACCOUNT_URL=http://localhost:5173
# Synerex website home (for logout redirect). If unset, derived from MY_ACCOUNT_URL
# WEBSITE_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Port for Flask app
PORT=8087
# NODE_ENV-style: development, production, test_prod
FLASK_ENV=development

# -----------------------------------------------------------------------------
# Sockets (Flask-SocketIO)
# -----------------------------------------------------------------------------
# Allowed origins for socket.io connections (matches config/local.js onlyAllowOrigins)
TRACKING_BASE_URL=http://localhost:8087

# -----------------------------------------------------------------------------
# Email (password reset)
# -----------------------------------------------------------------------------
# When set, password reset emails are sent via SMTP. Otherwise link is logged in dev only.
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_USE_TLS=true
# MAIL_FROM=noreply@tracking.local

# -----------------------------------------------------------------------------
# Static Assets (Production)
# -----------------------------------------------------------------------------
# S3 bucket for production static asset hosting (js, css, images, fonts)
# When set in production, redirect /js, /css, etc. to S3
S3_BUCKET_NAME=
# Optional - e.g. us-east-1
S3_REGION=

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Local path for file uploads and /files/* serving
# Local dev in 8087/flask_app/: use ../assets (sibling 8087 has assets)
# StorageService maps files to: {STORAGE_LOCAL_PATH}/files/
# Omit to auto-detect from app location
# STORAGE_LOCAL_PATH=../assets

# -----------------------------------------------------------------------------
# Maintenance (remote updates)
# -----------------------------------------------------------------------------
# Secret for POST /api/maintenance/* (required for maintenance endpoints)
# MAINTENANCE_SECRET=your-secret
# Path to update.sh (default: auto from 8087 root)
# UPDATE_SCRIPT=/vagrant/update.sh
# Source folder for list-files (default: ../8087 or /vagrant)
# MAINTENANCE_SOURCE_FOLDER=/vagrant
# GPG passphrase for encrypt/decrypt (enables key auth)
# MAINTENANCE_GPG_PASSPHRASE=

# -----------------------------------------------------------------------------
# Whitelabel
# -----------------------------------------------------------------------------
# Override base path for whitelabel directories (optional)
# Omit to auto-detect. Local dev: ../whitelabel
# WHITELABEL_BASE_PATH=../whitelabel
# Comma-separated hostnames that use default branding in dev (optional)
LOCAL_HOSTNAMES=localhost,127.0.0.1
# Domain-to-branding override: {"portal.xecoenergy.com": "xeco"}
# WHITELABEL_DOMAIN_MAPPINGS={}
# Default branding when hostname is local or portal
# WHITELABEL_DEFAULT_BRANDING=tracking
# App version for S3 static paths (from package.json)
# APP_VERSION=1.0.0
# Set to "test_prod" to skip S3 redirect in production-like runs
# ENVIRONMENT=development
# Base URL for invite email links (overrides TRACKING_BASE_URL when set)
# EMAIL_HOST=https://portal.xecoenergy.com
