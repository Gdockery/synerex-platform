<%
/*

 You can replace anything in this view.  It just needs to POST a request to /reset-password with
 an "email" parameter and a "token" parameter.  You should bootstrap the token onto the page using
 EJS (see the form below).  If the request is successful, the user will be logged in, so you can
 just navigate to / .  If there's any error, display a generic "an error occurrred" message.  Maybe
 also add a link back to the home page.

 */
%>

<link rel="stylesheet" type="text/css" href="/css/login.css">
<script src="/scripts/jquery-2.2.4.min.js"></script>
<script type="text/javascript">
  $(function() {
    $('.btn-reset').on('click', function() {
      $('.error').hide();
      $('.msg').hide();
      if(validateForm()) {
        $.post('/reset-password', { token: $('#inputToken').val(), password: $('#inputPassword').val() })
          .done(function() {
            window.location='/';
          })
          .fail(function(err) {
            $('.error').show().html('Unknown error occurred, please try again.');
          })
      }
      return false;
    })
    var validateForm = function() {
      if($('#inputPassword').val() == ''){
        $('.error').show().html('A new password is required.');
        return false;
      } else if($('#inputPassword').val() != $('#inputPasswordConfirm').val()){
        $('.error').show().html('Passwords must match.');
        return false;
      }
      return true;
    }
  });
</script>
<div class="container">
  <div class="card card-container">
    <img id="profile-img" class="logo-image" src="/images/logo-big.png" />
    <h1>Reset Password</h1>
    <p>Enter a new password below.</p>
    <form class="form-signin">
      <input type="hidden" id="inputToken" value="<%=token%>" />
      <input type="password" id="inputPassword" class="form-control" placeholder="Password" required autofocus>
      <input type="password" id="inputPasswordConfirm" class="form-control" placeholder="Confirm Password" required>
      <span class="msg"></span>
      <span class="error"></span>
      <button class="btn btn-green btn-reset btn-submit" type="button">Update password</button>
    </form>
    <a href="/login" class="bottom-link">
      Back to login
    </a>
  </div>
</div>
