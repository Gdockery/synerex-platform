<script src="/scripts/jquery-3.7.1.min.js"></script>
<script type="text/javascript">
  $(function() {
    $('.btn-signin').on('click', function() {
      $('.error').hide();
      $.post('/login', { email: $('#inputEmail').val(), password: $('#inputPassword').val() })
        .done(function() {
          window.location = '/';
        })
        .fail(function(err) {
          if (err.status === 404) {
            $('.error').show().html('Email address or password not found.');
          } else {
            $('.error').show().html('Unknown error occurred, please try again.');
          }
        });
      return false;
    });
  });
</script>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body, html {
    height: 100%;
    font-family: 'Segoe UI', Arial, sans-serif;
  }

  /* ── Animated gradient background ── */
  .login-page {
    min-height: 100vh;
    background: linear-gradient(135deg, #060d1f 0%, #0b1d38 25%, #06200f 60%, #0d1a08 100%);
    background-size: 300% 300%;
    animation: bgShift 16s ease infinite;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    position: relative;
    overflow: hidden;
  }

  @keyframes bgShift {
    0%   { background-position: 0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  /* ── Subtle grid overlay ── */
  .login-page::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
  }

  /* ── Glowing orbs ── */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.18;
    pointer-events: none;
    animation: float 10s ease-in-out infinite;
  }
  .orb-1 { width: 420px; height: 420px; background: #1a7a4a; top: -100px; left: -80px; animation-delay: 0s; }
  .orb-2 { width: 320px; height: 320px; background: #1e4db7; bottom: -80px; right: -60px; animation-delay: 4s; }
  .orb-3 { width: 200px; height: 200px; background: #0f9b58; top: 40%; right: 20%; animation-delay: 2s; }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-24px); }
  }

  /* ── Logo area ── */
  .login-brand {
    text-align: center;
    margin-bottom: 2rem;
    position: relative;
    z-index: 1;
  }

  .login-brand img {
    height: 52px;
    margin-bottom: 0.75rem;
    filter: drop-shadow(0 2px 8px rgba(0,0,0,0.4));
  }

  .login-brand .tagline {
    color: rgba(255,255,255,0.55);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ── Card ── */
  .login-card {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 400px;
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255,255,255,0.1);
  }

  .login-card h2 {
    color: #ffffff;
    font-size: 1.4rem;
    font-weight: 600;
    text-align: center;
    margin-bottom: 1.75rem;
    letter-spacing: 0.02em;
  }

  /* ── Inputs ── */
  .input-group {
    position: relative;
    margin-bottom: 1rem;
  }

  .input-group input {
    width: 100%;
    padding: 0.85rem 1.1rem;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 10px;
    color: #ffffff;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .input-group input::placeholder { color: rgba(255,255,255,0.38); }

  .input-group input:focus {
    border-color: rgba(26, 200, 120, 0.6);
    box-shadow: 0 0 0 3px rgba(26, 200, 120, 0.12);
  }

  /* ── Error ── */
  .error {
    display: none;
    color: #ff6b6b;
    font-size: 0.85rem;
    text-align: center;
    margin-bottom: 0.75rem;
    padding: 0.6rem 0.75rem;
    background: rgba(255, 80, 80, 0.1);
    border-radius: 8px;
    border: 1px solid rgba(255, 80, 80, 0.2);
  }

  /* ── Sign-in button ── */
  .btn-signin {
    display: block;
    width: 100%;
    padding: 0.9rem;
    margin-top: 0.5rem;
    background: linear-gradient(135deg, #18a868, #1a7a4a);
    color: #ffffff;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    letter-spacing: 0.04em;
    transition: opacity 0.2s, transform 0.15s;
    box-shadow: 0 4px 18px rgba(24, 168, 104, 0.35);
  }

  .btn-signin:hover  { opacity: 0.88; transform: translateY(-1px); }
  .btn-signin:active { opacity: 1;    transform: translateY(0); }

  /* ── Footer link ── */
  .login-footer {
    text-align: center;
    margin-top: 1.25rem;
  }

  .login-footer a {
    color: rgba(255,255,255,0.45);
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  .login-footer a:hover { color: rgba(255,255,255,0.8); }

  /* ── Copyright ── */
  .login-copyright {
    position: relative;
    z-index: 1;
    margin-top: 2rem;
    color: rgba(255,255,255,0.22);
    font-size: 0.75rem;
    text-align: center;
    letter-spacing: 0.05em;
  }
</style>

<div class="login-page">
  <!-- Glowing orbs -->
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>

  <!-- Logo -->
  <div class="login-brand">
    <img src="/images/synerex_logo_white.png" alt="Synerex">
    <div class="tagline">Tracking Portal</div>
  </div>

  <!-- Card -->
  <div class="login-card">
    <h2>Sign In</h2>

    <div class="input-group">
      <input type="email" id="inputEmail" placeholder="Email address" required autofocus>
    </div>
    <div class="input-group">
      <input type="password" id="inputPassword" placeholder="Password" required>
    </div>

    <span class="error"></span>

    <button class="btn-signin">Sign In</button>

    <div class="login-footer">
      <a href="/forgot-password">Forgot your password?</a>
    </div>
  </div>

  <p class="login-copyright">&copy; <%= new Date().getFullYear() %> Synerex Laboratories LLC. All rights reserved.</p>
</div>
