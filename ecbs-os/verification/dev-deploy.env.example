# Copy this file outside git or source it manually before running scripts/ecbs_dev_deploy.py.
# Do not commit real passwords.

export ECBS_DEV_REMOTE="xcorp@100.91.109.59"
export ECBS_DEV_REPO="/home/xcorp/synerex-platform"
export ECBS_DEV_BRANCH="master"

# ECBS OS database connection used by EF migrations and ECBS.Api.
export ECBS_CONNECTION_STRING="server=<mysql-container-ip>;port=3306;database=ecbs_os;user=ecbs_app;password=<password>"

# Legacy tracking adapter connection used by ECBS.Api read endpoints.
export TRACKING_DB_HOST="<tracking-mysql-container-ip>"
export TRACKING_DB_PORT="3306"
export TRACKING_DB_NAME="tracking"
export TRACKING_DB_USER="<tracking-user>"
export TRACKING_DB_PASSWORD="<tracking-password>"

# URL used inside the frontend container to call ECBS.Api.
export ECBS_FRONTEND_API_BASE_URL="http://172.18.0.1:5090"
