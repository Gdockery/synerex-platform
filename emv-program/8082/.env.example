# =============================================================================
# EMV Program - Environment Variables
# =============================================================================
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# License Service URL
LICENSE_SERVICE_URL=http://localhost:8080/license

# Database URL (MySQL)
EMV_DB_URL=mysql://emv_user:EmvPass123@localhost:3307/emv
Synerex_USE_SQLITE=0

# URLs
WEBSITE_URL=http://localhost:8080
EMV_BASE_URL=http://localhost:8082
SERVICE_MANAGER_URL=http://localhost:9000
HTML_REPORT_URL=http://localhost:8084
PDF_SERVICE_URL=http://localhost:8083
WEATHER_SERVICE_URL=http://127.0.0.1:8200
INCENTIVE_SERVICE_URL=http://localhost:8203
CHART_SERVICE_URL=http://localhost:8086
OLLAMA_AI_URL=http://127.0.0.1:8090
OLLAMA_LOCAL_URL=http://localhost:11434
UTILITY_RATE_SERVICE_URL=http://localhost:8202

LOCAL_HOSTNAMES=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# Tracking Integration (Bill Analytic import, Push Analysis)
# -----------------------------------------------------------------------------
# Tracking program base URL. Required for legacy page Tracking Integration.
# Local: http://127.0.0.1:8087  |  Docker: http://tracking-program:8087
TRACKING_URL=http://127.0.0.1:8087
# Shared API key for service-to-service calls. Set same value in Tracking .env.
TRACKING_API_KEY=tracking-push-secret
EMV_API_KEY=tracking-push-secret
