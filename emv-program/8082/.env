# License Service URL
LICENSE_SERVICE_URL=http://localhost:8080/license

# Database URL (MySQL). Default: localhost:3307 so the app works when run on the host (mysql-emv container must publish 3307).
# When run in Docker, docker-compose overrides this with mysql-emv:3306.
EMV_DB_URL=mysql://emv_user:EmvPass123@localhost:3307/emv

# Keep database features enabled (MySQL is selected via EMV_DB_URL)
Synerex_USE_SQLITE=0

# Website URL
WEBSITE_URL=http://localhost:8080

# EMV base URL
EMV_BASE_URL=http://localhost:8082

# Service Manager URL
SERVICE_MANAGER_URL=http://localhost:9000

# HTML report service URL
HTML_REPORT_URL=http://localhost:8084

# PDF generator service URL
PDF_SERVICE_URL=http://localhost:8083

# Weather service URL
WEATHER_SERVICE_URL=http://127.0.0.1:8200

# Incentive service URL
INCENTIVE_SERVICE_URL=http://localhost:8203

# Chart service URL
CHART_SERVICE_URL=http://localhost:8086

# Ollama AI service URL
OLLAMA_AI_URL=http://127.0.0.1:8090

# Ollama local service URL
OLLAMA_LOCAL_URL=http://192.168.1.14:11434

# Capture service URL
CAPTURE_SERVICE_URL=http://localhost:8089

# Utility rate service URL
UTILITY_RATE_SERVICE_URL=http://localhost:8202

# Local hostnames (comma-separated)
LOCAL_HOSTNAMES=localhost,127.0.0.1
